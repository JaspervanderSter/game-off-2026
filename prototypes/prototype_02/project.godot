; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Shapeshifters Duel"
config/description="Prototype 02: auto-battler duel loop with single-target shapeshifting."
config/version="0.2.0"
run/main_scene="res://main.tscn"
run/main_scene.web_benchmark="res://tests/perf_benchmark.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
config/windows_native_icon="res://icon.ico"

[autoload]

Sfx="*res://addons/tuning_fork/sfx.gd"

[audio]

general/default_playback_type.web=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.16, 0.12, 0.1, 1)

[editor_plugins]

enabled=PackedStringArray("res://addons/tuning_fork/plugin.cfg")
